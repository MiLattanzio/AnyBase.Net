@page "/"
@inject IJSRuntime JavaScript
@inject NavigationManager Navigation

<PageTitle>Playground · AnyBase.Net</PageTitle>

<header class="hero">
    <a class="brand" href="./" aria-label="AnyBase.Net playground">
        <span class="brand-mark" aria-hidden="true">A<sup>n</sup></span>
        <span>AnyBase.Net</span>
    </a>
    <a class="github-link" href="https://github.com/MiLattanzio/AnyBase.Net" target="_blank" rel="noreferrer">
        GitHub <span aria-hidden="true">↗</span>
    </a>

    <div class="hero-copy">
        <p class="eyebrow">WebAssembly playground</p>
        <h1>Un alfabeto qualsiasi.<br /><span>Ogni byte, al suo posto.</span></h1>
        <p class="lede">
            Codifica e decodifica testo UTF-8 direttamente nel browser. Nessun server,
            nessun dato inviato altrove.
        </p>
    </div>
</header>

<main class="workspace">
    <section class="control-panel" aria-labelledby="settings-title">
        <div class="section-heading">
            <span class="step">01</span>
            <div>
                <p class="eyebrow">Sistema</p>
                <h2 id="settings-title">Scegli l’alfabeto</h2>
            </div>
        </div>

        <label for="preset">Preset</label>
        <select id="preset" @bind="SelectedPreset" @bind:after="PresetChanged">
            @foreach (var preset in Presets)
            {
                <option value="@preset.Key">@preset.Name</option>
            }
            <option value="custom">Personalizzato</option>
        </select>

        <label for="alphabet">Simboli ordinati <span>zero → massimo</span></label>
        <textarea id="alphabet"
                  class="alphabet-input"
                  rows="3"
                  spellcheck="false"
                  @bind="Alphabet"
                  @bind:event="oninput"
                  @onfocus="UseCustomPreset"></textarea>

        <label for="separator">Separatore <span>facoltativo</span></label>
        <input id="separator"
               class="separator-input"
               type="text"
               spellcheck="false"
               placeholder="es. - oppure ::"
               @bind="Separator"
               @bind:event="oninput" />

        @if (CurrentValidation.IsTextCompatible)
        {
            <div class="validation valid" role="status">
                <strong>Alfabeto valido</strong>
                <span>@ValidationSummary</span>
            </div>
        }
        else
        {
            <div class="validation invalid" role="alert">
                <strong>Configurazione non valida</strong>
                <ul>
                    @foreach (var diagnostic in CurrentValidation.Diagnostics)
                    {
                        <li>@diagnostic.Message</li>
                    }
                </ul>
            </div>
        }

        <button type="button" class="share-action" @onclick="ShareConfiguration">
            Condividi configurazione via URL
        </button>

        <div class="stats" aria-live="polite">
            <div><span>Base</span><strong>@BaseSize</strong></div>
            <div><span>Digit / byte</span><strong>@DigitsPerByte</strong></div>
            <div><span>Versione</span><strong>@LibraryVersion</strong></div>
        </div>
    </section>

    <section class="converter-panel" aria-labelledby="converter-title">
        <div class="section-heading converter-heading">
            <span class="step">02</span>
            <div>
                <p class="eyebrow">Trasformazione</p>
                <h2 id="converter-title">Prova la libreria</h2>
            </div>
            <div class="mode-switch" aria-label="Modalità">
                <button class="@(Mode == TransformMode.Encode ? "active" : null)"
                        type="button"
                        @onclick="() => SetMode(TransformMode.Encode)">Codifica</button>
                <button class="@(Mode == TransformMode.Decode ? "active" : null)"
                        type="button"
                        @onclick="() => SetMode(TransformMode.Decode)">Decodifica</button>
            </div>
        </div>

        <label for="input">@(Mode == TransformMode.Encode ? "Testo UTF-8" : "Testo codificato")</label>
        <textarea id="input"
                  class="value-input"
                  rows="6"
                  spellcheck="false"
                  @bind="Input"
                  @bind:event="oninput"></textarea>

        <button class="primary-action" type="button" @onclick="Transform" disabled="@(!CanTransform)">
            <span>@(Mode == TransformMode.Encode ? "Codifica" : "Decodifica")</span>
            <span aria-hidden="true">→</span>
        </button>

        <div class="output-header">
            <label for="output">Risultato</label>
            <div>
                <button type="button" class="text-button" @onclick="Swap" disabled="@string.IsNullOrEmpty(Output)">Inverti</button>
                <button type="button" class="text-button" @onclick="Copy" disabled="@string.IsNullOrEmpty(Output)">Copia</button>
            </div>
        </div>
        <textarea id="output" class="value-output" rows="6" readonly value="@Output"></textarea>

        @if (!string.IsNullOrEmpty(Message))
        {
            <p class="message @(HasError ? "error" : "success")" role="status">@Message</p>
        }
    </section>
</main>

<footer>
    <p>AnyBase.Net · conversioni locali in WebAssembly</p>
    <p>Powered by NumeralSystems.Net 5.3.0</p>
</footer>

@code {
    private static readonly IReadOnlyList<AlphabetPreset> Presets = new[]
    {
        new AlphabetPreset("binary", "Binario", AnyBaseAlphabets.Binary),
        new AlphabetPreset("octal", "Ottale", AnyBaseAlphabets.Octal),
        new AlphabetPreset("decimal", "Decimale", AnyBaseAlphabets.Decimal),
        new AlphabetPreset("hex", "Esadecimale", AnyBaseAlphabets.Hexadecimal),
        new AlphabetPreset("base32", "Base32", AnyBaseAlphabets.Base32),
        new AlphabetPreset("base64", "Base64", AnyBaseAlphabets.Base64),
        new AlphabetPreset("base64url", "Base64 URL-safe", AnyBaseAlphabets.Base64Url)
    };

    private string SelectedPreset { get; set; } = "hex";
    private static string LibraryVersion { get; } =
        typeof(Base<>).Assembly.GetName().Version?.ToString(3) ?? "dev";
    private string Alphabet { get; set; } = AnyBaseAlphabets.Hexadecimal;
    private string Separator { get; set; } = string.Empty;
    private string Input { get; set; } = "Ciao, mondo 🌍";
    private string Output { get; set; } = string.Empty;
    private string Message { get; set; } = "Pronto: scegli una modalità e trasforma il testo.";
    private bool HasError { get; set; }
    private TransformMode Mode { get; set; } = TransformMode.Encode;

    private AlphabetValidationResult CurrentValidation => string.IsNullOrEmpty(Separator)
        ? AlphabetValidator.Validate(Alphabet)
        : AlphabetValidator.ValidateWithSeparator(Alphabet, Separator);

    private bool CanTransform => CurrentValidation.IsTextCompatible;

    private int BaseSize => Alphabet.Distinct().Count();

    private string DigitsPerByte => CurrentValidation.IsValid
        ? new Base<char>(Alphabet).Size.ToString()
        : "—";

    private string ValidationSummary => string.IsNullOrEmpty(Separator)
        ? "I simboli possono essere concatenati senza ambiguità."
        : $"I simboli saranno separati da “{Separator}”.";

    protected override void OnInitialized()
    {
        ApplyConfigurationFromUrl();
    }

    private void PresetChanged()
    {
        var preset = Presets.FirstOrDefault(candidate => candidate.Key == SelectedPreset);
        if (preset != null)
        {
            Alphabet = preset.Alphabet;
        }

        ClearResult();
    }

    private void UseCustomPreset()
    {
        SelectedPreset = "custom";
    }

    private void SetMode(TransformMode mode)
    {
        Mode = mode;
        Output = string.Empty;
        Message = mode == TransformMode.Encode
            ? "Inserisci testo UTF-8 da codificare."
            : "Incolla una sequenza prodotta con lo stesso alfabeto e separatore.";
        HasError = false;
    }

    private void Transform()
    {
        try
        {
            var converter = AnyBase.Create(Alphabet);
            Output = Mode switch
            {
                TransformMode.Encode when !string.IsNullOrEmpty(Separator) =>
                    converter.EncodeToString(Input, Separator),
                TransformMode.Decode when !string.IsNullOrEmpty(Separator) =>
                    converter.DecodeToString(Input, Separator),
                TransformMode.Encode => converter.EncodeToString(Input),
                _ => converter.DecodeToString(Input)
            };
            Message = Mode == TransformMode.Encode
                ? $"{System.Text.Encoding.UTF8.GetByteCount(Input)} byte → {Output.Length} caratteri"
                : $"{Input.Length} caratteri → {System.Text.Encoding.UTF8.GetByteCount(Output)} byte";
            HasError = false;
        }
        catch (Exception exception) when (exception is
            ArgumentException or
            FormatException or
            InvalidOperationException or
            DecoderFallbackException)
        {
            Output = string.Empty;
            Message = exception.Message;
            HasError = true;
        }
    }

    private void Swap()
    {
        if (string.IsNullOrEmpty(Output))
        {
            return;
        }

        Input = Output;
        Mode = Mode == TransformMode.Encode ? TransformMode.Decode : TransformMode.Encode;
        Transform();
    }

    private async Task Copy()
    {
        if (string.IsNullOrEmpty(Output))
        {
            return;
        }

        await CopyToClipboard(Output, "Risultato copiato negli appunti.");
    }

    private async Task ShareConfiguration()
    {
        var parameters = new List<string>();
        if (SelectedPreset == "custom")
        {
            parameters.Add($"alphabet={Uri.EscapeDataString(Alphabet)}");
        }
        else
        {
            parameters.Add($"preset={Uri.EscapeDataString(SelectedPreset)}");
        }

        if (!string.IsNullOrEmpty(Separator))
        {
            parameters.Add($"separator={Uri.EscapeDataString(Separator)}");
        }

        parameters.Add($"mode={Mode.ToString().ToLowerInvariant()}");
        var uri = new Uri(Navigation.Uri);
        var shareUrl = uri.GetLeftPart(UriPartial.Path) + "?" + string.Join("&", parameters);
        Navigation.NavigateTo(shareUrl, replace: true);
        await CopyToClipboard(shareUrl, "URL della configurazione copiato negli appunti.");
    }

    private async Task CopyToClipboard(string value, string successMessage)
    {
        try
        {
            await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", value);
            Message = successMessage;
            HasError = false;
        }
        catch (JSException)
        {
            Message = "Il browser non ha consentito l’accesso agli appunti.";
            HasError = true;
        }
    }

    private void ApplyConfigurationFromUrl()
    {
        var query = ParseQuery(new Uri(Navigation.Uri).Query);
        if (query.TryGetValue("preset", out var presetName))
        {
            var preset = Presets.FirstOrDefault(candidate =>
                string.Equals(candidate.Key, presetName, StringComparison.OrdinalIgnoreCase));
            if (preset != null)
            {
                SelectedPreset = preset.Key;
                Alphabet = preset.Alphabet;
            }
        }
        else if (query.TryGetValue("alphabet", out var customAlphabet))
        {
            SelectedPreset = "custom";
            Alphabet = customAlphabet;
        }

        if (query.TryGetValue("separator", out var separator))
        {
            Separator = separator;
        }

        if (query.TryGetValue("mode", out var mode) &&
            Enum.TryParse<TransformMode>(mode, ignoreCase: true, out var parsedMode))
        {
            Mode = parsedMode;
        }
    }

    private static IReadOnlyDictionary<string, string> ParseQuery(string query)
    {
        var values = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separatorIndex = pair.IndexOf('=');
            var rawKey = separatorIndex < 0 ? pair : pair[..separatorIndex];
            var rawValue = separatorIndex < 0 ? string.Empty : pair[(separatorIndex + 1)..];
            values[Uri.UnescapeDataString(rawKey.Replace('+', ' '))] =
                Uri.UnescapeDataString(rawValue.Replace('+', ' '));
        }

        return values;
    }

    private void ClearResult()
    {
        Output = string.Empty;
        Message = "Configurazione aggiornata.";
        HasError = false;
    }

    private sealed record AlphabetPreset(string Key, string Name, string Alphabet);

    private enum TransformMode
    {
        Encode,
        Decode
    }
}
