<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <Title>AnyBase.Net</Title>
    <PackageId>AnyBase.Net</PackageId>
    <Description>Encode and decode text or bytes with any ordered alphabet.</Description>
    <PackageTags>encoding;base-conversion;numeral-system;radix</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>NumeralSystems.Net 5.3.0 support, UTF-8 text round trips, deterministic alphabets, and stricter validation.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NumeralSystems.Net" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
